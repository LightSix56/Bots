# Почтовый бот (bot.py) — ящик Mail.ru
MAIL_USER=you@mail.ru
MAIL_PASS=пароль-или-пароль-приложения

# Токены ботов. У каждого бота свой токен: так проще отозвать один, не задев остальные.
MAIL_TG_BOT_TOKEN=123456:AAA...
NEWS_TG_BOT_TOKEN=123456:BBB...
WEATHER_TG_BOT_TOKEN=123456:CCC...

# Общий получатель. Обязателен: запасного chat_id в коде нет.
TG_CHAT_ID=962277709

# Необязательно. Путь к файлу состояния; в GitHub Actions задаётся в workflow.
# STATE_PATH=data/state.json

# Необязательно. CHECK_MODE=1 печатает результат в консоль вместо отправки.
# CHECK_MODE=0
